#!/usr/bin/env python3
"""currently output plugin "{{.Name}}", created by `currently plugin new`.

Add it to currently.yaml:

    plugins:
      commands:
        - ["{{.Python}}", "{{.Script}}"]
    outputs:
      {{.Name}}:
        target: example
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import currently_plugin  # noqa: E402


class Output(currently_plugin.Output):
    name = "{{.Name}}"
    version = "0.1.0"
    description = "TODO: where this output sends UPS data"

    def validate(self, config):
        return [] if "target" in config else ["target is required"]

    def run(self, host, config, stop):
        for ups in host.list_ups():
            currently_plugin.log("UPS", name=ups["name"], status=ups["vars"].get("ups.status"))
        for event in host.events():
            if stop.is_set():
                return
            if event["type"] != "update":
                # TODO: send it to config["target"].
                currently_plugin.log("event", ups=event["ups"], type=event["type"], message=event["message"])


if __name__ == "__main__":
    currently_plugin.serve_output(Output())
