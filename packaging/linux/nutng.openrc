#!/sbin/openrc-run
# OpenRC service for nutng (Alpine and other OpenRC systems).

name="nutng"
description="nut-ng UPS monitor"
command="/usr/bin/nutng"
command_args="serve"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/nutng.log"
error_log="/var/log/nutng.log"
supervisor=supervise-daemon
respawn_delay=5
respawn_max=0

# Secrets for *_env settings in nutng.yaml.
[ -r /etc/default/nutng ] && . /etc/default/nutng && export $(grep -E '^[A-Za-z_][A-Za-z0-9_]*=' /etc/default/nutng | cut -d= -f1)

depend() {
	need net
	after firewall
}
