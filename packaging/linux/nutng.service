# systemd unit installed by the nutng packages. It matches the unit that
# `nutng service install` writes to /etc/systemd/system (which takes
# precedence if both exist).
[Unit]
Description=nut-ng UPS monitor
Documentation=https://github.com/nut-ng/nut-ng
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/nutng serve
Restart=always
RestartSec=5
# Secrets for *_env settings in nutng.yaml, as NAME=value lines.
EnvironmentFile=-/etc/default/nutng
# nutng runs as root so it can open any USB UPS and shut the computer
# down. There is no filesystem sandboxing (ProtectSystem and the like),
# because shutdown hooks are your own scripts and may write anywhere.

[Install]
WantedBy=multi-user.target
