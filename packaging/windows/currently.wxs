<!--
  WiX Toolset (v5) source for the Currently MSI. Build it with build-msi.ps1.

  The installer puts currently.exe (and plugins) in C:\Program Files\currently,
  adds that folder to PATH, and installs and starts the "currently" service,
  the same service `currently service install` creates. The config lives in
  C:\ProgramData\currently\currently.yaml (write it with `currently init`); without
  one, Currently finds USB UPSes by itself. Uninstalling keeps the config.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Currently" Manufacturer="Currently" Version="$(Version)"
           UpgradeCode="E32A154F-EF7F-4641-A694-DBE673BD1831" Scope="perMachine">
    <!-- MSI versions are numbers only: 0.1.0-alpha.1 and 0.1.0 are both 0.1.0,
         so same-version upgrades must be allowed for one to replace the other. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Currently is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/duskglow/currently" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="currently">
        <Directory Id="PLUGINSFOLDER" Name="plugins" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="Currently">
      <Component Directory="INSTALLFOLDER">
        <File Id="CurrentlyExe" Source="$(BinDir)\currently.exe" KeyPath="yes" />
        <ServiceInstall Name="currently" DisplayName="Currently UPS monitor"
                        Description="Monitors UPSes and serves their state to monitoring tools (Currently)"
                        Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem"
                        Arguments="serve">
          <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart"
                              ThirdFailureActionType="restart" RestartServiceDelayInSeconds="5"
                              ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl Id="CurrentlyService" Name="currently" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
        <Environment Id="CurrentlyPath" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="yes" />
      </Component>
      <Component Directory="INSTALLFOLDER">
        <File Id="ExampleConfig" Source="$(SrcDir)\currently.example.yaml" KeyPath="yes" />
      </Component>
      <Component Directory="INSTALLFOLDER">
        <File Id="Readme" Source="$(SrcDir)\README.md" KeyPath="yes" />
      </Component>
      <Component Directory="INSTALLFOLDER">
        <File Id="License" Source="$(SrcDir)\LICENSE" KeyPath="yes" />
      </Component>
      <Component Directory="INSTALLFOLDER">
        <File Id="Notice" Source="$(SrcDir)\NOTICE" KeyPath="yes" />
      </Component>
      <Component Directory="PLUGINSFOLDER">
        <File Id="MqttPlugin" Source="$(BinDir)\plugins\currently-output-mqtt.exe" KeyPath="yes" />
      </Component>
      <Component Directory="PLUGINSFOLDER">
        <File Id="SnmpPlugin" Source="$(BinDir)\plugins\currently-driver-snmp.exe" KeyPath="yes" />
      </Component>
      <Component Directory="PLUGINSFOLDER">
        <File Id="SerialPlugin" Source="$(BinDir)\plugins\currently-driver-serial.exe" KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>
