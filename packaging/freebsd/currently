#!/bin/sh
#
# PROVIDE: currently
# REQUIRE: NETWORKING devfs
# BEFORE: LOGIN
# KEYWORD: shutdown
#
# rc.d script for Currently, the UPS monitor. Enable it with
#
#   sysrc currently_enable=YES
#   service currently start
#
# currently_config: config file (default /usr/local/etc/currently/currently.yaml)
# currently_env_file: NAME=value secrets for *_env settings
#                 (default /usr/local/etc/currently/currently.env)

. /etc/rc.subr

name="currently"
rcvar="currently_enable"

load_rc_config $name

: ${currently_enable:="NO"}
: ${currently_config:="/usr/local/etc/currently/currently.yaml"}
: ${currently_env_file:="/usr/local/etc/currently/currently.env"}

pidfile="/var/run/${name}.pid"
procname="/usr/sbin/daemon"
command="/usr/sbin/daemon"
# daemon(8) restarts Currently 5 seconds after it exits and sends its output
# to syslog.
command_args="-P ${pidfile} -r -R 5 -S -T ${name} -t ${name} /usr/local/bin/currently serve"
if [ -f "${currently_config}" ]; then
	command_args="${command_args} --config ${currently_config}"
fi

run_rc_command "$1"
